{
  "name": "Despensa.casa",
  "short_name": "Despensa",
  "description": "La comida de tu casa: qué hay en la refri, qué cocinar y dónde comprar más barato.",
  "lang": "es-PE",
  "start_url": "/?app=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBF9F4",
  "theme_color": "#141414",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Vence hoy", "url": "/?app=1#inicio", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "En la refri", "url": "/?app=1#refri", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mi semana", "url": "/?app=1#semana", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Precios", "url": "/?app=1#precios", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  }
}
